# Atlas environment template (SERVER_ARCHITECTURE.md §4.f).
#
# Copy to `.env` (gitignored) for local dev, or to /etc/atlas/atlas.env (root:atlas,
# 0600) on the server. NEVER put real secret values in THIS file — it is the only
# env file committed to git. Real values for the two secrets below exist ONLY in
# /etc/atlas/atlas.env on the box.

# ── Secrets (the gateway is the only ANTHROPIC_API_KEY holder; auth is the only pepper user) ──
# The single Anthropic key — held only by src/server/anthropic/gateway.ts.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Mixed into every device-token hash (sha256(token + pepper)). Must be ≥16 chars.
AUTH_TOKEN_PEPPER=changeme-generate-a-long-random-string

# ── Single-tenant identity ──
# The bootstrap operator user id. Must match src/db/schema.ts BOOTSTRAP_USER_ID
# and the worker / ai.ask / seed-token defaults so all rows share one owner.
ATLAS_USER_ID=atlas-operator

# ── Connectors (SERVER_ARCHITECTURE.md §4.f Phase 5) — DEPLOY-TIME CONFIG ──
# Real Gmail/Calendar/Drive OAuth. These are REAL credentials the operator creates
# in the Google Cloud Console (APIs & Services → Credentials → OAuth 2.0 Client ID,
# "Web application"); do NOT invent values. If unset, connectors fall back to the
# offline/demo fixture feed (see CONNECTORS_DEMO below).
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
# Must EXACTLY match an Authorized redirect URI on the OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/api/connectors/callback

# Encryption key for refresh tokens at rest (AES-256-GCM). NEVER stored in the DB
# — only ciphertext is. A 32-byte key as base64/hex, or a passphrase ≥32 chars.
# Generate, e.g.:  openssl rand -base64 32
CONNECTOR_ENCRYPTION_KEY=changeme-32-bytes-base64-or-a-long-passphrase

# Force the offline/demo fixture feed even when OAuth IS configured. Set to 1 for
# local dev / demos so connectors read worker/src/connectors/fixtures/*.json
# instead of real inboxes. Real connectors also auto-fall-back to demo when the
# OAuth client or encryption key above is missing.
# CONNECTORS_DEMO=1

# ── Optional gateway/worker tuning (sane defaults baked into config.ts) ──
# CONNECTOR_MAX_SIGNALS_PER_POLL=20
# WORKER_CONCURRENCY=1
