{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-token": "tsx src/db/seed-token.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "predev": "ATLAS_SEED=1 tsx src/db/migrate.ts",
    "worker:dev": "tsx watch worker/src/index.ts",
    "worker:once": "tsx worker/src/once.ts",
    "worker:build": "tsc --noEmit -p worker/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@tanstack/react-query": "^5.59.0",
    "@trpc/client": "^11.0.0-rc.660",
    "@trpc/react-query": "^11.0.0-rc.660",
    "@trpc/server": "^11.0.0-rc.660",
    "better-sqlite3": "^11.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.36.4",
    "lucide-react": "^0.460.0",
    "next": "^15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "superjson": "^2.2.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0-beta.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0-beta.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.60.1"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
